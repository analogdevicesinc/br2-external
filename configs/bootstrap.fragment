BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL)/board/adi/adsp/bootstrap/linux.fragment"
BR2_SYSTEM_BIN_SH_BUSYBOX=y
BR2_PACKAGE_MTD_FLASHCP=y
BR2_PACKAGE_E2FSPROGS=y
BR2_PACKAGE_ZSTD=y
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL)/board/adi/adsp/bootstrap/overlay"
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL)/board/adi/adsp/bootstrap/busybox-blockdev.fragment"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL)/board/adi/adsp/bootstrap/post-build.sh"
BR2_PACKAGE_MTD_MKFSUBIFS=n
BR2_TARGET_ROOTFS_EXT2=n
BR2_TARGET_ROOTFS_EXT2_4=n
BR2_TARGET_ROOTFS_INITRAMFS=y
BR2_TARGET_ROOTFS_UBI=n
BR2_TARGET_ROOTFS_UBIFS=n
BR2_ROOTFS_POST_IMAGE_SCRIPT=""
BR2_ROOTFS_POST_IMAGE_SCRIPT_ARGS=""
