BR2_PACKAGE_BUSYBOX_SHOW_OTHERS=y
BR2_PACKAGE_LIBIIO=y
# BR2_PACKAGE_LIBIIO_XML_BACKEND is not set
# BR2_PACKAGE_LIBIIO_NETWORK_BACKEND is not set
# BR2_PACKAGE_LIBIIO_USB_BACKEND is not set
# BR2_PACKAGE_LIBIIO_SERIAL_BACKEND is not set
BR2_PACKAGE_I2C_TOOLS=y
BR2_SYSTEM_DHCP=""
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL)/board/alif/devkit-e8/rootfs_overlay"
BR2_TARGET_GENERIC_HOSTNAME="alif-dk-e8"
BR2_LINUX_KERNEL_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL)/board/alif/devkit-e8/linux.fragment"
BR2_LINUX_KERNEL_INTREE_DTS_NAME="alif/ensemble/devkit/devkit-e8-adi"
BR2_LINUX_KERNEL_CUSTOM_DTS_DIR="$(BR2_EXTERNAL)/board/alif/devkit-e8/dts"
BR2_TARGET_ARM_TRUSTED_FIRMWARE_ADDITIONAL_VARIABLES="AARCH32_SP=sp_min ARM_LINUX_KERNEL_AS_BL33=1 PRELOADED_BL33_BASE=0x80020000 ARM_PRELOADED_DTB_BASE=0x80010000 ALIF_TRUSTED_SRAM_BASE=0x027DE000 AP_HYPERRAM_EN=1 AP_MEMORY_BUS_WIDTH=8 ISSI_HYPERRAM_EN=0 ISSI_FLASH_EN=0 MX_FLASH_EN=0 AES_EN=0"
BR2_PACKAGE_IFUPDOWN_SCRIPTS=y
