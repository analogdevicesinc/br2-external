#!/bin/sh

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs devtmpfs /dev

set -o pipefail

EMMC_DEV=/dev/mmcblk0
NAND_DEV=/dev/mtd5
RCU0_STAT=0x3108C004
BITP_RCU_STAT_BMODE=8
BITM_RCU_STAT_BMODE=0x00000F00
SPI_BMODE=1

NETWORK_CONFIGURED=0
BASE_URL=

rescue_shell() {
	echo
	echo "Dropping to rescue shell. From here you can:"
	echo "  reboot -f     -- reboot the board"
	echo "  /init         -- restart the installer"
	echo
	exec /bin/sh
}

setup_network() {
	if [ "$NETWORK_CONFIGURED" = "1" ]; then
		return 0
	fi

	echo
	echo "To continue, enter your PC's IP address. Leave empty to abort."
	printf "PC IP address: "
	read -r PC_IP

	if [ -z "$PC_IP" ]; then
		echo "No IP entered, returning to menu."
		return 1
	fi

	echo "Configuring network..."
	for NET_IFACE in $(ip -o link show | awk -F': ' '!/lo/ && !/LOOPBACK/ {print $2}'); do
		ip link set "$NET_IFACE" up
		udhcpc -i "$NET_IFACE" -n -q -T 3 && break
	done

	case "$PC_IP" in
		*:*)
			BASE_URL="http://${PC_IP}"
			;;
		*)
			BASE_URL="http://${PC_IP}:8000"
			;;
	esac

	NETWORK_CONFIGURED=1
}

install_spi_uboot() {
	echo
	echo "---- SPI Flash (U-Boot) ----"

	if ! flash_erase /dev/mtd0 0 0; then
		echo "ERROR: Failed to erase mtd0."
		return 1
	fi
	if ! flashcp /lib/firmware/u-boot-spl.ldr /dev/mtd0; then
		echo "ERROR: Failed to write u-boot-spl.ldr to mtd0."
		return 1
	fi

	if ! flash_erase /dev/mtd1 0 0; then
		echo "ERROR: Failed to erase mtd1."
		return 1
	fi
	if ! flashcp /lib/firmware/u-boot.ldr /dev/mtd1; then
		echo "ERROR: Failed to write u-boot.ldr to mtd1."
		return 1
	fi

	sync
	echo "SPI U-Boot install complete."
}

install_emmc() {
	if ! setup_network; then
		return 1
	fi

	echo
	echo "---- eMMC ----"
	echo "Downloading ${BASE_URL}/debug/emmc.img.gz to ${EMMC_DEV}..."

	if ! wget -O - "${BASE_URL}/debug/emmc.img.gz" | gunzip -c | dd of="$EMMC_DEV" bs=64K conv=fsync; then
		echo "ERROR: Failed to download, decompress, or write emmc.img.gz"
		return 1
	fi

	sync
	echo "eMMC install complete."
}

install_emmc_fedora() {
	if ! install_emmc; then
		return 1
	fi

	echo
	echo "---- Rootfs ----"
	ROOTFS_URL="${BASE_URL}/fedora/adsp-arm64-rootfs.tar.zst"
	ROOTFS_PART="${EMMC_DEV}p2"
	ROOTFS_MNT=/mnt/rootfs

	if ! blockdev --rereadpt "$EMMC_DEV"; then
		echo "ERROR: Failed to re-read partition table on ${EMMC_DEV}."
		return 1
	fi

	echo "Formatting ${ROOTFS_PART} as ext4..."
	if ! mkfs.ext4 -F "$ROOTFS_PART"; then
		echo "ERROR: Failed to format ${ROOTFS_PART}."
		return 1
	fi

	mkdir -p "$ROOTFS_MNT"
	if ! mount "$ROOTFS_PART" "$ROOTFS_MNT"; then
		echo "ERROR: Failed to mount ${ROOTFS_PART}."
		return 1
	fi

	echo "Downloading and extracting ${ROOTFS_URL}..."
	if ! wget -O - "$ROOTFS_URL" | zstd -d | tar -xf - -C "$ROOTFS_MNT"; then
		umount "$ROOTFS_MNT" 2>/dev/null
		echo "ERROR: Failed to download or extract adsp-arm64-rootfs.tar.zst"
		return 1
	fi

	umount "$ROOTFS_MNT"
	sync
	echo "Rootfs install complete."
}

install_spi_nor() {
	if ! setup_network; then
		return 1
	fi

	echo
	echo "---- SPI NOR (kernel + rootfs) ----"

	echo "Downloading ${BASE_URL}/debug/kernel.itb..."
	if ! wget -O /tmp/kernel.itb "${BASE_URL}/debug/kernel.itb"; then
		echo "ERROR: Failed to download kernel.itb."
		return 1
	fi

	echo "Downloading ${BASE_URL}/debug/rootfs.erofs..."
	if ! wget -O /tmp/rootfs.erofs "${BASE_URL}/debug/rootfs.erofs"; then
		echo "ERROR: Failed to download rootfs.erofs."
		return 1
	fi

	if ! flash_erase /dev/mtd2 0 0; then
		echo "ERROR: Failed to erase mtd2 (kernel)."
		return 1
	fi
	if ! flashcp /tmp/kernel.itb /dev/mtd2; then
		echo "ERROR: Failed to write kernel.itb to mtd2."
		return 1
	fi

	if ! flash_erase /dev/mtd3 0 0; then
		echo "ERROR: Failed to erase mtd3 (rootfs)."
		return 1
	fi
	if ! flashcp /tmp/rootfs.erofs /dev/mtd3; then
		echo "ERROR: Failed to write rootfs.erofs to mtd3."
		return 1
	fi

	rm -f /tmp/kernel.itb /tmp/rootfs.erofs
	sync
	echo "SPI NOR kernel + rootfs install complete."
}

install_nand() {
	if ! setup_network; then
		return 1
	fi

	echo
	echo "---- NAND ----"
	echo "Downloading ${BASE_URL}/debug/nand.img to ${NAND_DEV}..."

	if ! wget -O - "${BASE_URL}/debug/nand.img" | ubiformat "$NAND_DEV" -f - -y; then
		echo "ERROR: Failed to download or write nand.img"
		return 1
	fi

	sync
	echo "NAND install complete."
}

do_reboot() {
	echo
	echo "Set the switch S1 to position 1 (SPI boot)."
	echo "Waiting for switch..."

	while true; do
		val=$(devmem $RCU0_STAT 32)
		mode=$(( (val & BITM_RCU_STAT_BMODE) >> BITP_RCU_STAT_BMODE))

		if [ "$mode" -eq "$SPI_BMODE" ]; then
			echo "SPI boot mode detected."
			echo "Rebooting..."
			reboot -f
			exec /bin/sh
		fi

		sleep 1
	done
}

while true; do
	echo
	echo "======== Installer ========"
	echo
	echo "Select an option:"
	echo "  1) Install U-Boot to SPI flash"
	echo "  2) Buildroot kernel and root filesystem (eMMC)"
	echo "  3) Buildroot kernel and Fedora root filesystem (eMMC)"
	echo "  4) Buildroot kernel and root filesystem (NAND)"
	echo "  5) Buildroot kernel and root filesystem (SPI NOR)"
	echo "  0) Reboot"
	echo "  s) Rescue shell"
	echo
	printf "Choice: "
	read -r CHOICE

	case "$CHOICE" in
		1) install_spi_uboot ;;
		2) install_emmc ;;
		3) install_emmc_fedora ;;
		4) install_nand ;;
		5) install_spi_nor ;;
		0) do_reboot ;;
		s) rescue_shell ;;
		*) echo "Invalid choice." ;;
	esac
done
