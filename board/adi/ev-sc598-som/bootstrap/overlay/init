#!/bin/sh

mount -t proc proc /proc
mount -t sysfs sys /sys
mount -t devtmpfs devtmpfs /dev

set -e
set -o pipefail

EMMC_DEV=/dev/mmcblk0
RCU0_STAT=0x3108C004
BITP_RCU_STAT_BMODE=8
BITM_RCU_STAT_BMODE=0x00000F00
SPI_BMODE=1 #SPI Master Boot

rescue_shell() {
    echo
    echo "$*"
    echo
    echo "Dropping to rescue shell. From here you can:"
    echo "  reboot -f     -- reboot the board"
    echo "  /init         -- restart the installer"
    echo
    exec /bin/sh
}

echo
echo "======== Installer Environment ========"
echo "Install U-Boot to SPI Flash"
echo
echo "This will erase and program SPI flash."
printf "Continue? [y/N]: "

read -r ans

case "$ans" in
  y|Y)
    echo "Installing to SPI flash..."

    flash_erase /dev/mtd0 0 0
    flashcp /lib/firmware/u-boot-spl.ldr /dev/mtd0

    flash_erase /dev/mtd1 0 0
    flashcp /lib/firmware/u-boot.ldr /dev/mtd1

    sync
    echo "SPI install complete"
    ;;
  *)
    rescue_shell "SPI install skipped."
    ;;
esac

echo
echo "======== Install Image on eMMC ========"
echo
echo "Select what to install:"
echo "  1) Buildroot kernel and root filesystem"
echo "  2) Buildroot kernel and Fedora root filesystem"
echo "  0) Skip"
echo
printf "Choice [0/1/2]: "
read -r INSTALL_CHOICE

case "$INSTALL_CHOICE" in
  1|2) ;;
  *)
    echo "Skipping eMMC install."
    INSTALL_CHOICE=0
    ;;
esac

if [ "$INSTALL_CHOICE" != "0" ]; then
    echo
    echo "To continue, enter your PC's IP address. Leave empty to abort."
    printf "PC IP address: "
    read -r PC_IP

    if [ -z "$PC_IP" ]; then
        rescue_shell "No IP entered, eMMC install aborted."
    fi

    echo "Configuring network..."
    for NET_IFACE in $(ip -o link show | awk -F': ' '!/lo/ && !/LOOPBACK/ {print $2}'); do
        ip link set "$NET_IFACE" up
        udhcpc -i "$NET_IFACE" -n -q -T 3 && break
    done

    case "$PC_IP" in
        *:*)
            BASE_URL="http://${PC_IP}"
            ;;
        *)
            BASE_URL="http://${PC_IP}:8000"
            ;;
    esac

    echo
    echo "---- eMMC ----"
    echo "Downloading ${BASE_URL}/emmc.img.gz to ${EMMC_DEV}..."

    if ! wget -O - "${BASE_URL}/emmc.img.gz" | gunzip -c | dd of="$EMMC_DEV" bs=64K conv=fsync; then
        rescue_shell "ERROR: Failed to download, decompress, or write emmc.img.gz"
    fi

    echo "eMMC install complete."

    if [ "$INSTALL_CHOICE" = "2" ]; then
        echo
        echo "---- Rootfs ----"
        ROOTFS_URL="${BASE_URL}/adsp-sc598-rootfs.tar.zst"
        ROOTFS_PART="${EMMC_DEV}p2"
        ROOTFS_MNT=/mnt/rootfs

        blockdev --rereadpt "$EMMC_DEV"

        echo "Formatting ${ROOTFS_PART} as ext4..."
        if ! mkfs.ext4 -F "$ROOTFS_PART"; then
            rescue_shell "ERROR: Failed to format ${ROOTFS_PART}."
        fi

        mkdir -p "$ROOTFS_MNT"
        if ! mount "$ROOTFS_PART" "$ROOTFS_MNT"; then
            rescue_shell "ERROR: Failed to mount ${ROOTFS_PART}."
        fi

        echo "Downloading and extracting ${ROOTFS_URL}..."
        if ! wget -O - "$ROOTFS_URL" | zstd -d | tar -xf - -C "$ROOTFS_MNT"; then
            umount "$ROOTFS_MNT"
            rescue_shell "ERROR: Failed to download or extract adsp-sc598-rootfs.tar.zst"
        fi

        umount "$ROOTFS_MNT"
        sync
        echo "Rootfs install complete."
    fi
fi

echo
echo "Set the switch S1 to position 1 (SPI boot)."
echo "Waiting for switch..."

while true; do
    val=$(devmem $RCU0_STAT 32)
    mode=$(( (val & BITM_RCU_STAT_BMODE) >> BITP_RCU_STAT_BMODE))

    if [ "$mode" -eq "$SPI_BMODE" ]; then
        echo "SPI boot mode detected."
        echo "Rebooting..."
        reboot -f
        exec /bin/sh
    fi

    sleep 1
done
