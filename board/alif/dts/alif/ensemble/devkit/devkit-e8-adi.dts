/dts-v1/;

#include "devkit-e8.dts"
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/iio/adi,ad5592r.h>

&i2c0 {
	clock-frequency = <400000>;
	status = "okay";

	adxl345@53 {
		compatible = "adi,adxl345";
		reg = <0x53>;
	};

	ad5593r@10 {
		compatible = "adi,ad5593r";
		reg = <0x10>;
		#address-cells = <1>;
		#size-cells = <0>;

		channel@0 {
			reg = <0>;
			adi,mode = <CH_MODE_ADC>;
		};
	};

	adt7420@48 {
		compatible = "adi,adt7420";
		reg = <0x48>;
	};

	adxl367@1d {
		compatible = "adi,adxl367";
		reg = <0x1d>;
		pinctrl-names = "default";
		pinctrl-0 = <&pinctrl_click_int>;
		interrupts-extended = <&port8 1 IRQ_TYPE_LEVEL_HIGH>;
	};
};

&eth0 {
	status = "okay";
};

&pinmux {
	pinctrl_click_int: click-intgrp {
		pinmux = <PIN_P8_1__GPIO 0x23>;
	};
};
