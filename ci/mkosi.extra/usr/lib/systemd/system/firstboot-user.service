[Unit]
Description=First Boot User Setup
# serial-getty@ttySC0.service is auto-generated by systemd-getty-generator
# for the same /dev/ttySC0 we need exclusively during setup. Its own
# drop-in (ConditionPathExists=/var/lib/firstboot-user-done) keeps it
# from starting at all before this service has run, so there is no TTY
# race on first boot. OnSuccess= below brings the getty back up right
# after a real run of this service completes.
ConditionPathExists=!/var/lib/firstboot-user-done
After=dev-ttySC0.device
Requires=dev-ttySC0.device
OnSuccess=serial-getty@ttySC0.service

[Service]
Type=oneshot
ExecStart=/usr/local/bin/firstboot-user.sh
StandardInput=tty
StandardOutput=tty
StandardError=tty
TTYPath=/dev/ttySC0
TTYReset=yes
TTYVHangup=no

[Install]
WantedBy=multi-user.target
